// ============================================================================
// 财务云 · Prisma Schema
// Database: MySQL 8.0+ (InnoDB / utf8mb4)
// Tables: 55 business tables + Prisma migration table
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// ─── Phase 2: Base Tables (10 tables) ────────────────────────────────────────

model Company {
  id             BigInt    @id @default(autoincrement())
  name           String    @db.VarChar(255)
  shortName      String?   @map("short_name") @db.VarChar(100)
  taxId          String?   @map("tax_id") @db.VarChar(50)
  legalPerson    String?   @map("legal_person") @db.VarChar(100)
  registeredAddr String?   @map("registered_addr") @db.VarChar(512)
  contactPhone   String?   @map("contact_phone") @db.VarChar(30)
  status         String    @default("active") @db.VarChar(20)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  departments                 Department[]
  employees                   Employee[]
  users                       User[]
  fiscalPeriods               FiscalPeriod[]
  settlementEntities          SettlementEntity[]
  attachments                 Attachment[]
  accountingSubjects          AccountingSubject[]
  openingBalances             OpeningBalance[]
  bankAccounts                BankAccount[]
  fundTransactions            FundTransaction[]
  paymentTasks                PaymentTask[]
  suppliers                   Supplier[]
  sourceVouchers              SourceVoucher[]
  accountingVouchers          AccountingVoucher[]
  ledgerEntries               LedgerEntry[]
  trialBalances               TrialBalance[]
  monthlySnapshots            MonthlyFinancialSnapshot[]
  profitDetails               ProfitDetail[]
  taxFilings                  TaxFiling[]
  closingTasks                ClosingTask[]
  periodEndSteps              PeriodEndStep[]
  periodEndTransfers          PeriodEndTransfer[]
  customerReceivables         CustomerReceivable[]
  receivableAging             ReceivableAgingSnapshot[]
  collectorKpis               CollectorKpi[]
  budgets                     Budget[]
  fixedAssets                 FixedAsset[]
  inventoryItems              InventoryItem[]
  riskExceptions              RiskException[]
  riskIndicators              RiskIndicator[]
  chatMessages                ChatMessage[]
  aiAnalysisResults           AiAnalysisResult[]
  auditLogs                   AuditLog[]
  accountingChecks            AccountingCheck[]
  systemConnections           SystemConnection[]
  importTemplates             ImportTemplate[]
  importRecords               ImportRecord[]
  dataDictionaryEntries       DataDictionaryEntry[]
  cashFlowPredictions         CashFlowPrediction[]
  bankStatements              BankStatement[]
  platformSettlements         PlatformSettlement[]
  supplierPayables            SupplierPayable[]
  paymentApplications         PaymentApplication[]
  solvencyIndicators          SolvencyIndicator[]
  budgetExecutions            BudgetExecution[]
  inventoryInbounds           InventoryInbound[]
  inventoryOutbounds          InventoryOutbound[]
  expenseReports              ExpenseReport[]
  payrollRecords              PayrollRecord[]
  liveRoomProfitRankings      LiveRoomProfitRanking[]
  productProfitRankings       ProductProfitRanking[]
  businessFinancePenetrations BusinessFinancePenetration[]

  @@map("companies")
}

model Department {
  id        BigInt    @id @default(autoincrement())
  companyId BigInt    @map("company_id")
  name      String    @db.VarChar(255)
  parentId  BigInt?   @map("parent_id")
  managerId BigInt?   @map("manager_id")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  company   Company      @relation(fields: [companyId], references: [id])
  parent    Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  Department[] @relation("DepartmentHierarchy")
  employees Employee[]

  @@index([companyId])
  @@index([parentId])
  @@map("departments")
}

model Employee {
  id           BigInt    @id @default(autoincrement())
  companyId    BigInt    @map("company_id")
  departmentId BigInt?   @map("department_id")
  userId       BigInt?   @map("user_id")
  employeeNo   String    @map("employee_no") @db.VarChar(50)
  name         String    @db.VarChar(100)
  phone        String?   @db.VarChar(30)
  email        String?   @db.VarChar(255)
  position     String?   @db.VarChar(100)
  status       String    @default("active") @db.VarChar(20)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  company        Company         @relation(fields: [companyId], references: [id])
  department     Department?     @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payrollRecords PayrollRecord[]

  @@unique([employeeNo])
  @@index([companyId])
  @@index([departmentId])
  @@index([userId])
  @@map("employees")
}

model User {
  id           BigInt    @id @default(autoincrement())
  companyId    BigInt    @map("company_id")
  employeeId   BigInt?   @map("employee_id")
  username     String    @db.VarChar(100)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  displayName  String    @map("display_name") @db.VarChar(100)
  role         String    @db.VarChar(20)
  avatarUrl    String?   @map("avatar_url") @db.VarChar(512)
  lastLoginAt  DateTime? @map("last_login_at")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([username])
  @@index([companyId])
  @@index([employeeId])
  @@index([role])
  @@map("users")
}

model Role {
  id          BigInt   @id @default(autoincrement())
  name        String   @db.VarChar(50)
  code        String   @db.VarChar(50)
  description String?  @db.VarChar(512)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]

  @@unique([code])
  @@map("roles")
}

model Permission {
  id        BigInt   @id @default(autoincrement())
  code      String   @db.VarChar(100)
  name      String   @db.VarChar(100)
  groupName String?  @map("group_name") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@unique([code])
  @@map("permissions")
}

model RolePermission {
  id           BigInt   @id @default(autoincrement())
  roleId       BigInt   @map("role_id")
  permissionId BigInt   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model FiscalPeriod {
  id        BigInt    @id @default(autoincrement())
  companyId BigInt    @map("company_id")
  year      Int
  month     Int
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime  @map("end_date") @db.Date
  isClosed  Boolean   @default(false) @map("is_closed")
  closedAt  DateTime? @map("closed_at")
  closedBy  BigInt?   @map("closed_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  company                     Company                      @relation(fields: [companyId], references: [id])
  openingBalances             OpeningBalance[]
  accountingVouchers          AccountingVoucher[]
  cashFlowPredictions         CashFlowPrediction[]
  bankStatements              BankStatement[]
  platformSettlements         PlatformSettlement[]
  ledgerEntries               LedgerEntry[]
  trialBalances               TrialBalance[]
  monthlyFinancialSnapshot    MonthlyFinancialSnapshot?
  profitDetails               ProfitDetail[]
  receivableAgingSnapshots    ReceivableAgingSnapshot[]
  collectorKpis               CollectorKpi[]
  solvencyIndicators          SolvencyIndicator[]
  budgets                     Budget[]
  budgetExecutions            BudgetExecution[]
  depreciationRecords         DepreciationRecord[]
  payrollRecords              PayrollRecord[]
  taxFilings                  TaxFiling[]
  closingTasks                ClosingTask[]
  periodEndSteps              PeriodEndStep[]
  periodEndTransfers          PeriodEndTransfer[]
  riskIndicators              RiskIndicator[]
  aiAnalysisResults           AiAnalysisResult[]
  accountingChecks            AccountingCheck[]
  liveRoomProfitRankings      LiveRoomProfitRanking[]
  productProfitRankings       ProductProfitRanking[]
  businessFinancePenetrations BusinessFinancePenetration[]

  @@unique([companyId, year, month])
  @@index([isClosed])
  @@map("fiscal_periods")
}

model SettlementEntity {
  id        BigInt    @id @default(autoincrement())
  companyId BigInt    @map("company_id")
  name      String    @db.VarChar(255)
  type      String    @db.VarChar(50)
  status    String    @default("active") @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  company             Company              @relation(fields: [companyId], references: [id])
  sourceVouchers      SourceVoucher[]
  platformSettlements PlatformSettlement[]

  @@index([companyId])
  @@map("settlement_entities")
}

model Attachment {
  id             BigInt    @id @default(autoincrement())
  companyId      BigInt    @map("company_id")
  attachableType String    @map("attachable_type") @db.VarChar(50)
  attachableId   BigInt    @map("attachable_id")
  fileName       String    @map("file_name") @db.VarChar(512)
  fileUrl        String    @map("file_url") @db.VarChar(1024)
  fileSize       Int?      @map("file_size")
  mimeType       String?   @map("mime_type") @db.VarChar(100)
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([attachableType, attachableId])
  @@index([companyId])
  @@map("attachments")
}

// ─── Phase 4: Accounting Subjects + Opening Balances ────────────────────────

model AccountingSubject {
  id        BigInt    @id @default(autoincrement())
  companyId BigInt    @map("company_id")
  code      String    @db.VarChar(20)
  name      String    @db.VarChar(255)
  fullName  String?   @map("full_name") @db.VarChar(512)
  direction String    @db.VarChar(2)
  category  String    @db.VarChar(50)
  parentId  BigInt?   @map("parent_id")
  level     Int       @default(1)
  status    String    @default("启用") @db.VarChar(10)
  isLeaf    Boolean   @default(true) @map("is_leaf")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  company         Company             @relation(fields: [companyId], references: [id])
  parent          AccountingSubject?  @relation("SubjectHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children        AccountingSubject[] @relation("SubjectHierarchy")
  openingBalances OpeningBalance[]
  voucherEntries  VoucherEntry[]
  ledgerEntries   LedgerEntry[]
  trialBalances   TrialBalance[]

  @@unique([companyId, code])
  @@index([parentId])
  @@index([category])
  @@index([status])
  @@map("accounting_subjects")
}

model OpeningBalance {
  id             BigInt   @id @default(autoincrement())
  companyId      BigInt   @map("company_id")
  fiscalPeriodId BigInt   @map("fiscal_period_id")
  subjectId      BigInt   @map("subject_id")
  amount         Decimal  @db.Decimal(18, 2)
  direction      String   @db.VarChar(2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company      Company           @relation(fields: [companyId], references: [id])
  fiscalPeriod FiscalPeriod      @relation(fields: [fiscalPeriodId], references: [id])
  subject      AccountingSubject @relation(fields: [subjectId], references: [id])

  @@unique([fiscalPeriodId, subjectId])
  @@index([companyId])
  @@index([subjectId])
  @@map("opening_balances")
}

// ─── Phase 5: Vouchers ──────────────────────────────────────────────────────

// CollectedDocument 模型已合并入 SourceVoucher（2026-07-27）：采集录入即原始凭证电子版。

model SourceVoucher {
  id                 BigInt    @id @default(autoincrement())
  companyId          BigInt    @map("company_id")
  settlementEntityId BigInt?   @map("settlement_entity_id")
  voucherNo          String    @map("voucher_no") @db.VarChar(30) // 原始凭证号
  itemDescription    String    @map("item_description") @db.VarChar(512) // 事项/摘要
  businessDate       DateTime  @map("business_date") @db.Date
  amount             Decimal   @db.Decimal(18, 2)
  currency           String    @default("CNY") @db.VarChar(10)
  category           String?   @db.VarChar(50)
  source             String    @default("smart") @map("source") @db.VarChar(50) // smart=智能采集 manual=手工
  fileUrl            String?   @map("file_url") @db.VarChar(1024) // 原图（OSS / 本地）
  rawDataJson        Json?     @map("raw_data_json") // 录入结构化字段
  recognitionStatus  String    @default("pending") @map("recognition_status") @db.VarChar(50)
  includedDocuments  String?   @map("included_documents") @db.VarChar(512)
  riskStatus         String    @default("待确认") @map("risk_status") @db.VarChar(50)
  businessEntity     String?   @map("business_entity") @db.VarChar(255)
  counterparty       String?   @db.VarChar(255)
  handlerName        String?   @map("handler_name") @db.VarChar(100)
  handlerDepartment  String?   @map("handler_department") @db.VarChar(100)
  voucherId          BigInt?   @map("voucher_id") // 关联生成的记账凭证
  status             String    @default("待制证") @db.VarChar(50) // 待制证 / 已制证
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  company             Company                     @relation(fields: [companyId], references: [id])
  settlementEntity    SettlementEntity?           @relation(fields: [settlementEntityId], references: [id])
  businessFacts       VoucherBusinessFact[]
  verificationResults VoucherVerificationResult[]

  @@index([companyId])
  @@index([status])
  @@index([businessDate])
  @@index([recognitionStatus])
  @@index([voucherId])
  @@map("source_vouchers")
}

model VoucherBusinessFact {
  id                  BigInt   @id @default(autoincrement())
  voucherId           BigInt   @map("voucher_id")
  purchaseContent     String?  @map("purchase_content") @db.VarChar(512)
  quantity            String?  @db.VarChar(100)
  deliveryLocation    String?  @map("delivery_location") @db.VarChar(255)
  contractOrderNo     String?  @map("contract_order_no") @db.VarChar(100)
  inspectionReceiptNo String?  @map("inspection_receipt_no") @db.VarChar(100)
  invoiceNo           String?  @map("invoice_no") @db.VarChar(100)
  taxTotal            Decimal? @map("tax_total") @db.Decimal(18, 2)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  voucher SourceVoucher @relation(fields: [voucherId], references: [id])

  @@index([voucherId])
  @@map("voucher_business_facts")
}

model VoucherVerificationResult {
  id        BigInt   @id @default(autoincrement())
  voucherId BigInt   @map("voucher_id")
  checkItem String   @map("check_item") @db.VarChar(512)
  isPassed  Boolean  @default(true) @map("is_passed")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  voucher SourceVoucher @relation(fields: [voucherId], references: [id])

  @@index([voucherId])
  @@map("voucher_verification_results")
}

model AccountingVoucher {
  id              BigInt    @id @default(autoincrement())
  companyId       BigInt    @map("company_id")
  fiscalPeriodId  BigInt    @map("fiscal_period_id")
  sourceVoucherIds Json?   @map("source_voucher_ids")
  voucherNo       String    @map("voucher_no") @db.VarChar(30)
  voucherWord     String    @map("voucher_word") @db.VarChar(10)
  voucherNumber   Int       @map("voucher_number")
  voucherDate     DateTime  @map("voucher_date") @db.Date
  summary         String    @db.VarChar(512)
  debitAmount     Decimal   @default(0) @map("debit_amount") @db.Decimal(18, 2)
  creditAmount    Decimal   @default(0) @map("credit_amount") @db.Decimal(18, 2)
  attachmentCount Int       @default(0) @map("attachment_count")
  status          String    @default("draft") @db.VarChar(20)
  auditStatus     String    @default("pending") @map("audit_status") @db.VarChar(20)
  category        String?   @db.VarChar(50)
  creatorId       BigInt?   @map("creator_id")
  reviewerId      BigInt?   @map("reviewer_id")
  signerId        BigInt?   @map("signer_id")
  isVoided        Boolean   @default(false) @map("is_voided")
  voidReason      String?   @map("void_reason") @db.VarChar(512)
  sourceType      String?   @map("source_type") @db.VarChar(50)
  flowNo          String?   @map("flow_no") @db.VarChar(50)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  company      Company            @relation(fields: [companyId], references: [id])
  fiscalPeriod FiscalPeriod       @relation(fields: [fiscalPeriodId], references: [id])
  entries      VoucherEntry[]
  signatures   VoucherSignature[]

  @@unique([voucherNo])
  @@index([companyId])
  @@index([fiscalPeriodId])
  @@index([status])
  @@index([voucherDate])
  @@map("accounting_vouchers")
}

model VoucherEntry {
  id           BigInt   @id @default(autoincrement())
  voucherId    BigInt   @map("voucher_id")
  subjectId    BigInt   @map("subject_id")
  summary      String?  @db.VarChar(512)
  debitAmount  Decimal  @default(0) @map("debit_amount") @db.Decimal(18, 2)
  creditAmount Decimal  @default(0) @map("credit_amount") @db.Decimal(18, 2)
  direction    String   @db.VarChar(2)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  voucher AccountingVoucher @relation(fields: [voucherId], references: [id])
  subject AccountingSubject @relation(fields: [subjectId], references: [id])

  @@index([voucherId])
  @@index([subjectId])
  @@map("voucher_entries")
}

model VoucherSignature {
  id            BigInt   @id @default(autoincrement())
  voucherId     BigInt   @map("voucher_id")
  signerId      BigInt   @map("signer_id")
  signedAt      DateTime @map("signed_at")
  paymentStatus String?  @map("payment_status") @db.VarChar(20)
  note          String?  @db.VarChar(512)
  createdAt     DateTime @default(now()) @map("created_at")

  voucher AccountingVoucher @relation(fields: [voucherId], references: [id])

  @@index([voucherId])
  @@index([signerId])
  @@map("voucher_signatures")
}

// ─── Phase 6: Funds Management ───────────────────────────────────────────────

model BankAccount {
  id          BigInt    @id @default(autoincrement())
  companyId   BigInt    @map("company_id")
  accountName String    @map("account_name") @db.VarChar(255)
  accountNo   String    @map("account_no") @db.VarChar(100)
  bankName    String    @map("bank_name") @db.VarChar(255)
  accountType String    @map("account_type") @db.VarChar(50)
  currency    String    @default("CNY") @db.VarChar(10)
  balance     Decimal   @default(0) @db.Decimal(18, 2)
  status      String    @default("正常") @db.VarChar(20)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  company                 Company                  @relation(fields: [companyId], references: [id])
  fundTransactions        FundTransaction[]
  paymentTasks            PaymentTask[]
  bankStatements          BankStatement[]
  bankReconciliationItems BankReconciliationItem[]

  @@index([companyId])
  @@map("bank_accounts")
}

model FundTransaction {
  id               BigInt   @id @default(autoincrement())
  companyId        BigInt   @map("company_id")
  bankAccountId    BigInt   @map("bank_account_id")
  voucherId        BigInt?  @map("voucher_id")
  transactionDate  DateTime @map("transaction_date") @db.Date
  type             String   @db.VarChar(20)
  amount           Decimal  @db.Decimal(18, 2)
  counterparty     String?  @db.VarChar(255)
  summary          String?  @db.VarChar(512)
  isCashFlow       Boolean  @default(true) @map("is_cash_flow")
  cashFlowCategory String?  @map("cash_flow_category") @db.VarChar(50)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  company     Company     @relation(fields: [companyId], references: [id])
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])

  @@index([bankAccountId])
  @@index([transactionDate])
  @@index([type])
  @@map("fund_transactions")
}

model PaymentTask {
  id             BigInt    @id @default(autoincrement())
  companyId      BigInt    @map("company_id")
  bankAccountId  BigInt?   @map("bank_account_id")
  payee          String    @db.VarChar(255)
  payeeAccount   String?   @map("payee_account") @db.VarChar(100)
  amount         Decimal   @db.Decimal(18, 2)
  approvalStatus String    @map("approval_status") @db.VarChar(20)
  checkStatus    String    @map("check_status") @db.VarChar(20)
  paymentStatus  String    @map("payment_status") @db.VarChar(20)
  priority       String    @default("中") @db.VarChar(10)
  dueDate        DateTime? @map("due_date") @db.Date
  category       String?   @db.VarChar(50)
  createdBy      BigInt?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  company     Company      @relation(fields: [companyId], references: [id])
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])

  @@index([bankAccountId])
  @@index([paymentStatus])
  @@map("payment_tasks")
}

model CashFlowPrediction {
  id        BigInt   @id @default(autoincrement())
  companyId BigInt   @map("company_id")
  periodId  BigInt   @map("period_id")
  dayLabel  String   @map("day_label") @db.VarChar(50)
  dayOffset Int      @map("day_offset")
  balance   Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now()) @map("created_at")

  company Company      @relation(fields: [companyId], references: [id])
  period  FiscalPeriod @relation(fields: [periodId], references: [id])

  @@index([periodId])
  @@map("cash_flow_predictions")
}

// ─── Phase 7: Reconciliation ─────────────────────────────────────────────────

model BankStatement {
  id             BigInt   @id @default(autoincrement())
  companyId      BigInt   @map("company_id")
  bankAccountId  BigInt   @map("bank_account_id")
  fiscalPeriodId BigInt   @map("fiscal_period_id")
  statementNo    String?  @map("statement_no") @db.VarChar(100)
  totalEntries   Int      @default(0) @map("total_entries")
  totalDebit     Decimal  @default(0) @map("total_debit") @db.Decimal(18, 2)
  totalCredit    Decimal  @default(0) @map("total_credit") @db.Decimal(18, 2)
  importStatus   String   @default("pending") @map("import_status") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company      Company                  @relation(fields: [companyId], references: [id])
  bankAccount  BankAccount              @relation(fields: [bankAccountId], references: [id])
